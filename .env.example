# Oh My Coder ortam yapılandırması örneği
# Bu dosyayı .env olarak kopyalayıp sağlayıcı anahtarlarınızı girin.

# Web sunucusu için zorunlu harici yönetici anahtarı (en az 32 bayt).
# /settings girişinde kullanıcı adı: yonetici; parola: bu anahtar.
# Boş bırakılırsa web sunucusu başlamaz. Gerçek değeri Git'e eklemeyin.
OMC_API_TOKEN=
# Coolify TLS proxy arkasında ayar ekranının dış origin'i (yol içermez).
# Örnek biçim: https://omc.example.com — gerçek alan adınızı kullanın.
OMC_SETTINGS_ORIGIN=

# ===========================================
# AI özellikleri için en az bir sağlayıcı yapılandırın
# ===========================================

# DeepSeek（sağlayıcı kotasını güncel hesabınızdan kontrol edin）
# Anahtar yönetim adresi: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_api_key

# ===========================================
# İsteğe bağlı diğer modeller
# ===========================================

# Wenxin (Baidu)
# Anahtar yönetim adresi: https://console.bce.baidu.com/
WENXIN_API_KEY=your_api_key
WENXIN_SECRET_KEY=your_secret_key

# Tongyi (Alibaba)
# Anahtar yönetim adresi: https://dashscope.console.aliyun.com/
TONGYI_API_KEY=your_api_key

# Zhipu GLM (ChatGLM)
# Anahtar yönetim adresi: https://open.bigmodel.cn/
GLM_API_KEY=your_api_key

# MiniMax（MiniMax）
# Anahtar yönetim adresi: https://www.minimaxi.com/
MINIMAX_API_KEY=your_api_key

# Kimi（Moonshot）
# Anahtar yönetim adresi: https://platform.moonshot.cn/
KIMI_API_KEY=your_api_key

# Hunyuan (Tencent)
# Anahtar yönetim adresi: https://cloud.tencent.com/
HUNYUAN_API_KEY=your_api_key
HUNYUAN_SECRET_KEY=your_secret_key

# Doubao (ByteDance)
# Anahtar yönetim adresi: https://console.volcengine.com/
DOUBAO_API_KEY=your_api_key

# Tiangong AI
# Anahtar yönetim adresi: https://model-platform.tiangong.cn/
TIANGONG_API_KEY=your_api_key

# Spark (iFlytek)
# Anahtar yönetim adresi: https://console.xfyun.cn/
SPARK_API_KEY=your_api_key
SPARK_APP_ID=your_app_id
SPARK_SECRET_KEY=your_secret_key

# Baichuan
# Anahtar yönetim adresi: https://platform.baichuan-ai.com/
BAICHUAN_API_KEY=your_api_key

# ===========================================
# Kullanım açıklaması
# ===========================================
# 1. Dosyayı kopyalayın: cp .env.example .env
# 2. .env dosyasına gerçek sağlayıcı anahtarlarınızı girin
# 3. Ortamı dışa aktarın: set -a; source .env; set +a
# Veya doğrudan dışa aktarın:
#    export DEEPSEEK_API_KEY=your_key
#
# Mevcut uygulamanın sağlayıcı öncelik sırası:
# DeepSeek > Tiangong > Baichuan > Kimi > Doubao > MiniMax > GLM > Tongyi > Spark > Wenxin > Hunyuan
